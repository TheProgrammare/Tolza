"""c

// physics params
let g = 1.62             // lunar gravity (m/s²)
let thrust = 5.0         // mas trust (m/s²) whn power = 1.0

// start module state
var start_altitude = 100.0 // meters
var altitude = 100.0       // meters
var velocity = 0.0         // speed, m/s (positive = to the ground) 
var fuel = 50.0            // liter
var power = 0.0            // engine power (0 to 1)

fn main() 
{
  calculate_physics()
}

fn calculate_physics() {
  C::printf("=== MOON LANDING GAME ===\n"c)
  C::printf("Start Altitude : %.1f m\nFuel : %.1f L\n"c, altitude, fuel)
  C::printf("Enter a power engine between 0 and 1 for each stage.\n"c)
  C::printf("-------------------------------------------\n"c)

  while altitude > 0f {
    draw_interface()

    C::printf("Engine power (0-1) : "c)
    let valid_input = C::scanf("%lf"c, mut'power) != 1
    if !valid_input or power < 0.0 or power > 1.0 {
      C::printf("Invalid input. Use a value between 0 and 1.\n"c)
      return
    }

    // fuel consumption
    var fuel_use = power * 1.0 // consumption per seconds
    if fuel_use > fuel {
      C::printf("Not enough fuel, power reduce.\n"c)
      if fuel > 0f => power = fuel / 1.0 else => power = 0.0
      fuel_use = power * 1.0
    }

    fuel = fuel - fuel_use

    // Dynamic : acceleration = gravity - thrust power
    var acceleration = g - thrust * power

    // update speed and altitude (Δt=1s)
    velocity = velocity + acceleration
    altitude = altitude - velocity

    if altitude < 0f => altitude = 0.0
  }

  C::printf("\n=== MOON CONTACT ===\n"c)
  C::printf("Final speed : %.2f m/s\n"c, velocity)

  if velocity <= 3.0 => C::printf("Successful landing !\n"c)
  elif velocity <= 10.0 => C::printf("Raw landing, but you survive.\n"c)
  else => C::printf("LANDING CRASH ! Mission failed.\n"c)
}


fn draw_interface() {
  C::printf("=============================== MOON LANDING GAME ==============================\n"c)
    let before_lander: ssize = (start_altitude / 2.0 - altitude / 2.0) as ssize
    var after_lander: ssize = (start_altitude / 2.0) as ssize - before_lander - 20
    
    //C::printf("start(%2.f) / 2.0 - (altitude(%2.f) / 2.0) = before: %d\n"c, start_altitude, altitude, before_lander)
    //C::printf("start(%2.f) - before(%d) - 7 = after: %d \n"c, start_altitude, before_lander, after_lander)


    for i in 0..before_lander => C::printf("\n"c)  
    C::printf(lander_txt)
    
    draw_burst(after_lander)

    if after_lander < 0 => after_lander = 0
    for i in 0..after_lander => C::printf("\n"c)  

    C::printf(ground_txt)
    C::printf("\nAltitude : %.2f m | Speed : %.2f m/s | Fuel : %.2f L\n"c, altitude, velocity, fuel)
}

fn draw_burst(mut after_lander: ssize) {
  if power == 0.0 {

  }
  elif power <= 0.33 {
    C::printf(burst_1)
    after_lander = after_lander - 1
  }
  elif power <= 0.66 {
    C::printf(burst_2)
    after_lander = after_lander - 1
  }
  elif power <= 1.0 {
    C::printf(burst_3)
    after_lander = after_lander - 2
  }
}



