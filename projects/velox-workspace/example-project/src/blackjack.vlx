import bind::C::stdio as C
import bind::C::time as C
import bind::C::stdlib as C

const k_deck_size = 52
var player: [ssize; 10]
var dealer: [ssize; 10]
  
var p_size = 0
var d_size = 0

fn draw_card() -> ssize {
  var card = (C::rand() %m 13) + 1
  if card > 10 => card = 10

  return card as ssize
}

fn hand_value(ref hand: [ssize; ..]) -> ssize {
  var sum = 0
  var aces = 0

  for ref it in hand {
    sum += it
    if it == 1 => aces += 1
  }

  // As : 1 or 11
  while aces > 0 and sum + 10 <= 21 {
    sum += 10
    aces -= 1
  }

  return sum
}

fn print_hand(ref hand: [ssize; ..]) {
  for ref it in hand {
    C::printf("%d ", it)
  }
  C::printf("\n")
}

fn clear_hand(ref hand: [ssize; ..]) {
  for mut it in hand => it = 0
}

fn start_game() {
  C::system("clear")

  clear_hand(player)
  clear_hand(dealer)
  var p_size = 0
  var d_size = 0

  C::printf("Bienvenue dans le jeu du blackjack !\n")
  C::srand(C::time(nullptr) as! u32)
}

fn ask_draw() {
  var choice: cune = uninit
  C::printf("Tirer une carte ? [O/n] : ")
  C::scanf(" %c", addr'choice)

  if choice == "o" or choice == "O" {
    give_player_card()
    C::printf("Tes cartes : ")
    print_hand(player)
    C::printf("Valeur : %d\n\n", hand_value(player))
  }
  else {
    C::printf("Check !\n")
    break
  }
}

fn check_player_score() {
  let score = hand_value(player)

  if score > 21 {
    C::printf("Perdu ! Tu as dépassé 21.\n")
    ask_retry()
  }
  if score == 21 {
    C::printf("Blackjack ! Tu as gagné !\n")
    ask_retry()
  }
}

fn check_dealer_score() {
  let score = hand_value(dealer)

  if score > 21 {
    C::printf("Cartes de la banque : ")
    print_hand(dealer)
    C::printf("Gagné ! La banque a dépassé 21.\n")
    ask_retry()
  }
  if score == 21 {
    C::printf("Cartes de la banque : ")
    print_hand(dealer)
    C::printf("Perdu ! La banque a fait Blackjack.\n")
    ask_retry()
  }
}



fn ask_retry() {
  var choice: cune = uninit
  C::printf("Tu veux rejouer ? [O/n] : ")
  C::scanf(" %c", addr'choice)

  if choice == "o" or choice == "O" {
    start_game()
  }
  else {
    C::printf("Aurevoir !\n")
  }
  
}

fn give_player_card() {
  var card = draw_card()
  player[p_size] = card
  p_size += 1
  C::printf("Tu tire : %d\n", card)
}

fn give_dealer_card(copy print: bool = false) {
  var card = draw_card()
  dealer[d_size] = card
  d_size += 1
  if print {
    C::printf("La banque tire : %d\n", card)
  }
}

fn main() {
  start_game()

  // start distribute
  give_player_card()
  give_player_card()

  check_player_score()

  give_dealer_card(false)
  give_dealer_card(false)

  check_dealer_score()

  C::printf("Tes cartes : ")
  print_hand(player)
  C::printf("Valeur : %d\n\n", hand_value(player))

  while hand_value(player) < 21 {
    ask_draw()
  }

  check_player_score()

  C::printf("\nCartes de la banque : ")
  print_hand(dealer)

  while hand_value(dealer) < 17 {
    give_dealer_card(true)
  }

  C::printf("--------------\n")
  C::printf("Fin du jeu, calcul des scores...\n")
  C::printf("Tes cartes : ")
  print_hand(player)
  C::printf("Cartes de la banque : ")
  print_hand(dealer)

  let dealer_score = hand_value(dealer)
  let player_score = hand_value(dealer)
  C::printf("Score joueur : %d\n", player_score)
  C::printf("Score banque : %d\n", dealer_score)

  if dealer_score > 21 or player_score > dealer_score {
    C::printf("Tu gagnes !\n")
  } elif player_score < dealer_score {
    C::printf("La banque gagne.\n")
  } else {
    C::printf("Égalité.\n")
  }
  
}

