{
    "Tuple Definition": {
        "prefix": "Tuple",
        "body": [
            "(${1:Type1}, ${2:...})"
        ],
        "description": "Tuple declaration"
    },
    "Tuple Instance": {
        "prefix": "Tuple",
        "body": [
            "(${1:value1}, ${2:...})"
        ],
        "description": "Tuple declaration"
    },
    "Named Tuple Definition": {
        "prefix": "Named Tuple",
        "body": [
            "(${1:name1}: ${2:Type1}, ${3:...})"
        ],
        "description": "Named Tuple declaration"
    },
    "Named Tuple Instance": {
        "prefix": "Named Tuple Instance",
        "body": [
            "(${1:name1}: ${2:value1}, ${3:...})"
        ],
        "description": "Named Tuple instance"
    },
    "Goto": {
        "prefix": "goto",
        "body": [
            "goto ${1:Label}"
        ],
        "description": "Goto instruction"
    },
    "Goto Label": {
        "prefix": "label",
        "body": [
            "label ${1:Label} {",
            "  $0",
            "}"
        ],
        "description": "Label instruction"
    },
    "Function Definition": {
        "prefix": "fn",
        "body": [
            "fn ${1:Name}(${2:params}) -> ${3:Type} {",
            "  $0",
            "}"
        ],
        "description": "Function declaration"
    },
     "Function no return Definition": {
        "prefix": "fnn",
        "body": [
            "fn ${1:Name}(${2:params}) {",
            "  $0",
            "}"
        ],
        "description": "Function declaration no return"
    },
    "Lambda Definition": {
        "prefix": "lam",
        "body": [
            "lam ${1:Name}[${2:catch}](${3:params}) -> ${4:Type} {",
            "  $0",
            "}"
        ],
        "description": "Lambda declaration"
    },
    "Lambda anonym Definition": {
        "prefix": "lamm",
        "body": [
            "lam [${2:catch}](${3:params}) {",
            "  $0",
            "}"
        ],
        "description": "Anonymous lambda declaration"
    },
    "LLVM Instruction": {
        "prefix": "llvm",
        "body": [
            "llvm {",
            "  $0",
            "}"
        ],
        "description": "Literal LLVM instruction"
    },
    "ASM Instruction": {
        "prefix": "asm",
        "body": [
            "asm {",
            "  $0",
            "}"
        ],
        "description": "Literal assembly instruction"
    },
    "Return Definition": {
        "prefix": "return",
        "body": [
            "return ${1:result}"
        ],
        "description": "Return declaration"
    },
    "Enum Definition": {
        "prefix": "enum",
        "body": [
            "enum ${1:EName} {",
            "  $0,",
            "}"
        ],
        "description": "Enum definition"
    },
    "Component Definition": {
        "prefix": "comp",
        "body": [
            "comp ${1:CName} { ${2:filed_name}: ${3:Type}, }"
        ],
        "description": "Component definition"
    },
    "Role Definition": {
        "prefix": "role",
        "body": [
            "role ${1:RName} {",
            "  $0,",
            "}"
        ],
        "description": "Role definition"
    },
    "Entity Definition": {
        "prefix": "entity",
        "body": [
            "entity ${1:Name} {",
            "  use ${2:comp_name} = ${3:value},",
            "  $0",
            "}"
        ],
        "description": "Entity definition"
    },
    "Entity Constructor": {
        "prefix": "enew",
        "body": [
            "new (${1:params}) {",
            "  $0",
            "}"
        ],
        "description": "Entity constructor"
    },
     "Entity Destructor": {
        "prefix": "edel",
        "body": [
            "del {",
            "  $0",
            "}"
        ],
        "description": "Entity destructor"
    },
    "Entity Use Comp": {
        "prefix": "use",
        "body": [
            "use ${2:CName} = ${3:value},"
        ],
        "description": "Entity use component"
    },
    "Entity Operator": {
        "prefix": "op",
        "body": [
            "op ${1:operator} {",
            "  return ${2:operation}",
            "}"
        ],
        "description": "Entity operator"
    },
    "Entity Cast": {
        "prefix": "cast",
        "body": [
            "cast ${1:self/Type} as ${2:self/Type} {",
            "  $0",
            "}"
        ],
        "description": "Entity operator"
    },
    "System Definition": {
        "prefix": "sys",
        "body": [
            "sys ${1:Name}(${2:params}) {",
            "  ${3:comp/role/entity}(${4:name}) /*+*/ {",
            "    $0",
            "  }",
            "}"
        ],
        "description": "System definition"
    },
    "System Case": {
        "prefix": "sysc",
        "body": [
            "${1:comp/role/entity}(${2:name) /*+*/ {",
            "  $0",
            "}"
        ],
        "description": "System Case definition"
    },
    "Export Definition": {
        "prefix": "export",
        "body": [
            "export {",
            "  $0",
            "}"
        ],
        "description": "export declaration"
    },
    "Import": {
        "prefix": "import",
        "body": [
            "import ${1:Name}"
        ],
        "description": "import"
    },
    "Import Source": {
        "prefix": "import usr",
        "body": [
            "import usr: ${1:Name}"
        ],
        "description": "import source"
    },
    "Import Standard": {
        "prefix": "import std",
        "body": [
            "import std: ${1:Name}"
        ],
        "description": "import standard"  
    },
    "Import Package": {
        "prefix": "import pkg",
        "body": [
            "import pkg: ${1:Name}"
        ],
        "description": "import package"  
    },
    "Import Extern": {
        "prefix": "import ext",
        "body": [
            "import ext: ${1:Name/Lang}::${2:lib}"
        ],
        "description": "import extern"  
    },
    "Mod Definition": {
        "prefix": "mod",
        "body": [
            "mod ${1:Name} {",
            "  $0",
            "}"
        ],
        "description": "Module declaration"
    },
    "If Statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "  $0",
            "}"
        ],
        "description": "If statement"
    },
    "Ternary if": {
        "prefix": "if",
        "body": [
            "if ${1:condition} then ${2:true_case} else ${3:false_case}"
        ],
        "description": "Ternary if"
    },
    "Else Statement": {
        "prefix": "else",
        "body": [
            "else {",
            "  $0",
            "}"
        ],
        "description": "Else statement"
    },
    "For i range Statement": {
        "prefix": "for",
        "body": [
            "for i in ${3:range/array} {",
            "  $0",
            "}"
        ],
        "description": "For i range loop"
    },
    "For Item Statement": {
        "prefix": "forr",
        "body": [
            "for ${1:ref/mut} ${2:item} in ${3:range/array} {",
            "  $0",
            "}"
        ],
        "description": "For item loop"
    },
    "For Map Statement": {
        "prefix": "forrr",
        "body": [
            "for ${1:ref/mut} ${2:key}, ${3:ref/mut} ${4:item} in ${5:range/array} {",
            "  $0",
            "}"
        ],
        "description": "For map loop"
    },
    "Loop Statement": {
        "prefix": "loop",
        "body": [
            "loop {",
            "  ${2:// loop}",
            "  break",
            "}"
        ],
        "description": "Loop"
    },
    "While Statement": {
        "prefix": "while",
        "body": [
            "while ${1:Condition} {",
            "  ${2:// loop}",
            "}"
        ],
        "description": "While loop"
    },
    "Do while Statement": {
        "prefix": "do",
        "body": [
            "do {",
            "  ${2:// loop}",
            "} while ${1:Condition}"
        ],
        "description": "Do while loop"
    },
    "Match Statement": {
        "prefix": "match",
        "body": [
            "match ${1:variable} {",
            "  ${2:evaluator} => {",
            "    $0",
            "  }",
            "  other => {",
            "    $0",
            "  }",
            "}"
        ],
        "description": "Match statement"
    },
    "Pass parameter ref": {
        "prefix": "ref",
        "body": [
