        ],
        "description": "Pass parameter by mutable reference"
    },
    "Pass parameter force copy": {
        "prefix": "copy",
        "body": [
            "copy ${1:paramName}: ${2:Type}"
        ],
        "description": "Pass parameter by force copying"
    },
    "Pass parameter move": {
