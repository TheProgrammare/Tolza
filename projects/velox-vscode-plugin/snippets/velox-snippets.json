            "}"
        ],
        "description": "Named generic"
    },
    "Meta named": {
        "prefix": "# meta",
        "body": [
            "# meta ${1:name}(${2:params}) -> ${3:target1|target2}",
            "# ${4:directive}",
            "$0"
        ],
        "description": "private generic declaration"
    },
    "New value ptr": {
        "prefix": "new",
        "body": [
            "new ptr'${1:Type}(${2:value})"
        ],
        "description": "new pointer"
    },
    "New ptr": {
        "prefix": "neww",
        "body": [
            "new ptr'${2:Type}"
        ],
        "description": "new pointer"
    },
    "as cast": {
