{
    "Tuple Definition": {
        "prefix": "Tuple",
        "body": [
            "(${1:T}, ${2:U...})"
        ],
        "description": "Tuple declaration"
    },
    "Tuple Instance": {
        "prefix": "Tuple",
        "body": [
            "(${1:val1}, ${2:val2...})"
        ],
        "description": "Tuple declaration"
    },
    "Named Tuple Definition": {
        "prefix": "Named Tuple",
        "body": [
            "(${1:name}: ${2:T}, ${3:...})"
