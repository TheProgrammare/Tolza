{
  "name": "velox-vscode-plugin",
  "displayName": "Velox VS Code plugin",
  "description": "Plugin helps coding in Velox programming language!",
  "author": "Programmare",
  "publisher": "",
  "version": "1.0.0",
  "icon": "icons/velox-logo.png",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "velox",
        "aliases": [
          "Velox",
          "velox"
        ],
        "extensions": [
          ".vlx",
          ".vlxbind",
          ".vlxlib"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "velox",
        "scopeName": "source.velox",
        "path": "./syntaxes/velox.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "velox",
        "path": "./snippets/velox-snippets.json"
      }
    ]
  }
}