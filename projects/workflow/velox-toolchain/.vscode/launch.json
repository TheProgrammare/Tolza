{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug project creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox",
            "args": ["create", "workspace", "--path", "/mnt/data/Workspace/velox/projects/velox-workspace", "--name", "velox-example", "-f"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug audit",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox",
            "args": ["audit", "${workspaceFolder}/../../velox-workspace/velox-example"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug check",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox",
            "args": ["check", "workspace", "${workspaceFolder}/../../velox-workspace/velox-example"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug gui",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox",
            "args": ["gui", "${workspaceFolder}/../../velox-workspace/velox-example"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug build",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox",
            "args": ["build", "${workspaceFolder}/../../velox-workspace/velox-example/velox.toml"],
            "env": [],
            "cwd": "${workspaceFolder}",
            
        },
        {
            "name": "Release",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/velox",
            "args": ["build", "${workspaceFolder}/../../velox-workspace/velox-example"],
            "cwd": "${workspaceFolder}"
        }
    ]
}