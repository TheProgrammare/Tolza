{
    "version": "0.2.0",
    "configurations": [
         {
            "name": "Debug about",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-compiler",
            "args": ["--about"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug cogito",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-compiler",
            "args": ["cogito"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug build",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-compiler",
            "args": [
                "build", "/mnt/data/Workspace/velox/projects/velox-workspace/velox-example/velox.toml"
            ],
            "env": [],
            "cwd": "${workspaceFolder}"
            
        },
        {
            "name": "Release",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/velox-compiler",
            "args": ["build", "${workspaceFolder}/../../../velox-workspace/velox-example"],
            "cwd": "${workspaceFolder}"
        }
    ]
}