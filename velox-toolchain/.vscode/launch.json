{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug project creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-toolchain",
            "args": ["cw"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug audit",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-toolchain",
            "args": ["audit", "${workspaceFolder}/../velox-workspace/velox-example"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug version",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-toolchain",
            "args": ["--version"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug check",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-toolchain",
            "args": ["check", "${workspaceFolder}/../velox-workspace/velox-example"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug gui",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-toolchain",
            "args": ["gui", "${workspaceFolder}/../velox-workspace/velox-example"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug build",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-toolchain",
            "args": ["build", "${workspaceFolder}/../velox-workspace/velox-example"],
            "env": [],
            "cwd": "${workspaceFolder}",
            
        },
        {
            "name": "Release",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/velox",
            "args": ["build", "${workspaceFolder}/../velox-workspace/velox-example"],
            "cwd": "${workspaceFolder}"
        }
    ]
}