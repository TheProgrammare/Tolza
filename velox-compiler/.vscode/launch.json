{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug build",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/velox-compiler",
            "args": [
                "build",
                "--abi=LP64",
                "--arch=amd64",
                "--bits=64",
                "--os=linux",
                "--libc=",
                "--config=self",
                "--release",
                "--opt-level=0",
                "--warn-level=0",
                "-Dversion=1.0",
                "--print-ast",
                "--emit=bin",
                "--build=${workspaceFolder}/../velox-workspace/velox-example/build",
                "--project=${workspaceFolder}/../velox-workspace/velox-example",
                "--src=${workspaceFolder}/../velox-workspace/velox-example/src",
                "--vendor=${workspaceFolder}/../velox-workspace/velox-example/vendor",
                "--ffi-json=${workspaceFolder}/../velox-workspace/velox-example/ffi-json",
                "--binding=${workspaceFolder}/../velox-workspace/velox-example/binding"
            ],
            "env": [],
            "cwd": "${workspaceFolder}"
            
        },
        {
            "name": "Release",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/velox-compiler",
            "args": ["build", "${workspaceFolder}/../velox-workspace/velox-example"],
            "cwd": "${workspaceFolder}"
        }
    ]
}