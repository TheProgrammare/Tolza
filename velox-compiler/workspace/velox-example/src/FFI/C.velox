import extern C::stdlib

export {
  # if os == windows
  type _char=         u8
  # else // unix like
  type _char=         i8
  # end if

  type _schar=        i8
  type _uchar=        u8
  type _short=        i16
  type _ushort=       u16
  
  # if abi == LLP64
  type _int=          i32
  type _uint=         u32
  type _long=         i32
  type _ulong=        u32
  type _size=         u64
  type _ptr_diff=     i64
  # elif abi == ILP32
  type _int=          i32
  type _uint=         u32
  type _long=         i32
  type _ulong=        u32
  type _size=         u32
  type _ptr_diff=     i32
  # else // LP64
  type _int=          i32
  type _uint=         u32
  type _long=         i64
  type _ulong=        u64
  type _size=         u64
  type _ptr_diff=     i64
  # end if

  type _longlong=     i64
  type _ulonglong=    u64

  type _float=        f32
  type _double=       f64

  type _c=            _char
  type _sc=           _schar
  type _uc=           _uchar
  type _s=            _short
  type _us=           _ushort
  type _i=            _int
  type _ui=           _uint
  type _l=            _long
  type _ul=           _ulong
  type _ll=           _longlong
  type _ull=          _ulonglong

  type _f=            _float
  type _d=            _double

  type _str=           ptr'_char

  fn str_to_cstr(ref in_str: str) -> _str 
  {
      var out_str: _str
      
      var count = 0
      for character in in_str {
          out_str'at(count) = character
          count += 1
      }
      out_str'at(count) = "\0"

      return out_str
  }
}
