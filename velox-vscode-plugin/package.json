{
  "name": "velox-language-support",
  "displayName": "Velox language support",
  "description": "Extension to write code in the best language!",
  "author": "Programmare",
  "publisher": "",
  "version": "1.0.0",
  "icon": "images/velox-logo.png",
  "engines": { "vscode": "^1.98.0" },
  "categories": [ "Programming Languages" ],
  "contributes": {
    "languages": [{
      "id": "velox",
      "aliases": ["Velox", "velox"],
      "extensions": [".velox",".vel",".vlx", ".vlxb", ".veloxb", ".velb"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "velox",
      "scopeName": "source.velox",
      "path": "./syntaxes/velox.tmLanguage.json"
    }],
    "snippets": [{
      "language": "velox",
      "path": "./snippets/velox-snippets.json"
    }]
  }
}
