{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug about",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza-compiler",
            "args": [
                "--about"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug cogito",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza-compiler",
            "args": [
                "cogito"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug build classic",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza-compiler",
            "args": [
                "build",
                "${workspaceFolder}/../../tolza-workspace/example-project"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug check classic",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza-compiler",
            "args": [
                "check",
                "${workspaceFolder}/../../tolza-workspace/example-project/tolza.toml"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        }
    ]
}