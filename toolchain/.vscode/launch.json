{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug project creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "create",
                "workspace",
                "${workspaceFolder}/../../tolza-workspace",
                "--name",
                "tolza-example",
                "-f"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug config creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "create",
                "config",
                "${workspaceFolder}/../../tolza-workspace",
                "--name",
                "template"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug audit",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "audit",
                "${workspaceFolder}/../../tolza-workspace/tolza-example"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug check",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "check",
                "workspace",
                "${workspaceFolder}/../../tolza-workspace/tolza-example"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug gui",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "gui",
                "${workspaceFolder}/../../tolza-workspace/tolza-example"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug build",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "build",
                "--path",
                "${workspaceFolder}/../../tolza-workspace/tolza-example/tolza.toml"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Release",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/tolza",
            "args": [
                "build",
                "${workspaceFolder}/../../tolza-workspace/tolza-example"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-release"
        }
    ]
}