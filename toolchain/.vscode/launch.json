{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug workspace creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "new",
                "workspace",
                "~",
                "--name",
                "test",
                "-f"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug profile creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "new",
                "profile",
                "${workspaceFolder}/../../tolza-workspace/profile",
                "--name",
                "template"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug manifest creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "new",
                "manifest",
                "~",
                "--name",
                "test"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug audit",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "audit",
                "${workspaceFolder}/../../tolza-workspace/tolza-example"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug check",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "check",
                "workspace",
                "${workspaceFolder}/../../tolza-workspace/tolza-example"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug gui",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "gui",
                "${workspaceFolder}/../../tolza-workspace/tolza-example"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Debug build",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tolza",
            "args": [
                "build",
                "${workspaceFolder}/../../tolza-workspace/tolza-example/tolza.toml"
            ],
            "env": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug"
        }
    ]
}